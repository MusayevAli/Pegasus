# Local default: no API keys required. Node 22.13+ (25 tested).
HOST=127.0.0.1
PORT=3001
DB_PATH=./data/tripfit.sqlite
SEED_ON_START=true
# Remote/non-loopback binding requires both tokens. Keep the admin token off the iOS client.
ANALYTICS_ADMIN_TOKEN=
APP_ACCESS_TOKEN=
# Only server-side. Live AI does NOT enable live inventory or ticket issuance.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MODEL_TEXT=gpt-4.1-mini
OPENAI_MODEL_VISION=gpt-4.1-mini
AI_TIMEOUT_MS=20000
# Optional fixed sample-window start YYYY-MM-DD; unset rolls forward from tomorrow.
# SAMPLE_START_DATE=2026-10-10
INVENTORY_PROVIDER=sample
# Durable provider implementation must be supplied before live payment is enabled.
PAYMENT_MODE=demo
ABANDONMENT_MINUTES=30
ANALYTICS_MIN_SAMPLE=3
ACTIVE_TIME_THRESHOLD_SECONDS=30
