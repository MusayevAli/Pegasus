          "type": "string",
          "description": "Origin as a 3-letter IATA airport code, for example AYT, ESB, ADB, ATH, or AMS. Use IST for Istanbul Airport, SAW for Sabiha Gokcen, and IST_SAW only when the user asks for all Istanbul airports."
        },
        "destination": {
          "type": "string",
          "description": "Destination as a 3-letter IATA airport code, for example AYT, ESB, ADB, ATH, or AMS. Use IST for Istanbul Airport, SAW for Sabiha Gokcen, and IST_SAW only when the user asks for all Istanbul airports."
        },
        "departureDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Departure date in YYYY-MM-DD format."
        },
        "returnDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Return date in YYYY-MM-DD format for round trips."
        },
        "adults": {
          "type": "integer",
          "minimum": 1,
